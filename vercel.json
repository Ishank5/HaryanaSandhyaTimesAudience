{
  "rewrites": [
    {
      "source": "/article.html",
      "destination": "/api/article",
      "has": [
        {
          "type": "query",
          "key": "id"
        }
      ]
    }
  ],
  "headers": [
    {
      "source": "/api/article",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=300, stale-while-revalidate=86400"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}

