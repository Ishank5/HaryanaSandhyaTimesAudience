{
  "functions": {
    "api/article.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/article.html",
      "destination": "/api/article"
    }
  ],
  "headers": [
    {
      "source": "/api/article",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        }
      ]
    }
  ]
}
