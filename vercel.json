{
  "rewrites": [
    {
      "source": "/article.html",
      "destination": "/api/article"
    }
  ],
  "headers": [
    {
      "source": "/api/article",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}

